{
  "uid": "dora", "title": "DORA et santé du site", "timezone": "browser", "schemaVersion": 39, "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Déploiements en production", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 }, "datasource": { "uid": "prom" }, "targets": [{ "expr": "dora_deployments_total", "refId": "A" }] },
    { "id": 2, "type": "stat", "title": "Lead time (commit → prod)", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 }, "datasource": { "uid": "prom" }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "dora_lead_time_seconds", "refId": "A" }] },
    { "id": 3, "type": "stat", "title": "Taux d'échec (rollbacks)", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 }, "datasource": { "uid": "prom" }, "fieldConfig": { "defaults": { "unit": "percentunit" } }, "targets": [{ "expr": "dora_change_failure_rate", "refId": "A" }] },
    { "id": 4, "type": "stat", "title": "MTTR", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 }, "datasource": { "uid": "prom" }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "dora_mttr_seconds", "refId": "A" }] },
    { "id": 5, "type": "timeseries", "title": "Disponibilité du site", "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 }, "datasource": { "uid": "prom" }, "targets": [{ "expr": "last_over_time(probe_success{job=\"site\"}[35m])", "refId": "A" }] },
    { "id": 6, "type": "timeseries", "title": "Temps de réponse du site", "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 }, "datasource": { "uid": "prom" }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "last_over_time(probe_duration_seconds{job=\"site\"}[35m])", "refId": "A" }] }
  ]
}
