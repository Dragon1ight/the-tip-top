{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié — Thé Tip Top{% endblock %}
{% block body_class %}tunnel{% endblock %}
{% block body %}<section class="auth"><div class="card"><h1>Mot de passe oublié</h1>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('forgot') }}"><label for="email">Adresse e-mail</label><input id="email" type="email" name="email" autocomplete="email" required><button class="btn btn-sec block">Recevoir un lien</button></form>
<p><a href="{{ path('app_login') }}">Retour à la connexion</a></p></div></section>{% endblock %}
